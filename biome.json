{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
        "useMaxParams": { "level": "error", "options": { "max": 5 } },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 80, "skipBlankLines": true, "skipIifes": true }
        }
      },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/e2e/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useMaxParams": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
